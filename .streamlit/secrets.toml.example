# Vorlage für die Zugangsdaten.
#
# Lokal:            diese Datei nach .streamlit/secrets.toml kopieren und ausfüllen.
# Streamlit Cloud:  den Inhalt (ausgefüllt) unter App → Settings → Secrets einfügen.
#
# Ohne diesen Abschnitt läuft die App im lokalen Testmodus (nur auf dem eigenen Computer).
# Die Werte stehen im Supabase-Dashboard unter Project Settings → API (bzw. „API Keys“).
# Verwende den „anon“- bzw. „publishable“-Schlüssel – NIEMALS den „service_role“/„secret“-Schlüssel.

[supabase]
url = "https://DEIN-PROJEKT.supabase.co"
anon_key = "eyJhbGciOi...dein-anon-schluessel..."
